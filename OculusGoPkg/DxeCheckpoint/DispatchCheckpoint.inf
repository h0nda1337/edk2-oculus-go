[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = OculusGoDxeDispatchCheckpoint
  FILE_GUID = 6c6aa7b5-eefd-419b-b511-07be596c5a10
  MODULE_TYPE = BASE
  LIBRARY_CLASS = DebugAgentLib|DXE_CORE

[Sources]
  Checkpoint.c
  MemoryServices.c
  ImageGcd.c
  ConfigTables.c
  DebugImage.c
  Dispatch.c

[BuildOptions]
  GCC:*_*_AARCH64_CC_FLAGS = -DOCULUS_GO_DXE_MEMORY=1 -DOCULUS_GO_DXE_GCD=1 -DOCULUS_GO_DXE_TABLES=1 -DOCULUS_GO_DXE_DEBUG=1 -DOCULUS_GO_DXE_DISPATCH=1

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OculusGoPkg/OculusGoPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  HobLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  ExtractGuidedSectionLib

[Guids]
  gEfiDebugImageInfoTableGuid
  gEfiHobMemoryAllocModuleGuid
  gEfiDxeServicesTableGuid
  gEfiHobListGuid
  gEfiMemoryTypeInformationGuid

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiDevicePathUtilitiesProtocolGuid
