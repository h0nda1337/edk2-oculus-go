## SPDX-License-Identifier: BSD-2-Clause-Patent
# Integrated ARM64 ABI header, followed by an EDK2 firmware volume.
# Header fields: official Go kernel Documentation/arm64/booting.txt.
# FV reset-vector generation: upstream EDK2 GenFv and ArmVirtQemuKernel.fdf.
[FD.OCULUS_GO_DIRECT]
BaseAddress   = 0x80080000|gArmTokenSpaceGuid.PcdFdBaseAddress
!if $(GO_BUILD_FLAVOR) == OculusGo || $(GO_BUILD_FLAVOR) == OculusGoShellQemu
Size          = 0x01400000|gArmTokenSpaceGuid.PcdFdSize
!else
Size          = 0x00400000|gArmTokenSpaceGuid.PcdFdSize
!endif
ErasePolarity = 1
BlockSize     = 0x1000
!if $(GO_BUILD_FLAVOR) == OculusGo || $(GO_BUILD_FLAVOR) == OculusGoShellQemu
NumBlocks     = 0x1400
!else
NumBlocks     = 0x400
!endif

0x00000000|0x00001000
DATA = {
  0x00,0x04,0x00,0x14, 0x1f,0x20,0x03,0xd5, # b +0x1000; nop
  0x00,0x00,0x08,0x00,0x00,0x00,0x00,0x00, # text_offset 0x80000
!if $(GO_BUILD_FLAVOR) == OculusGo || $(GO_BUILD_FLAVOR) == OculusGoShellQemu
  0x00,0x00,0x40,0x01,0x00,0x00,0x00,0x00, # image_size 20 MiB
!else
  0x00,0x00,0x40,0x00,0x00,0x00,0x00,0x00, # image_size 4 MiB
!endif
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00, # flags
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x41,0x52,0x4d,0x64, 0x00,0x00,0x00,0x00
}

!if $(GO_BUILD_FLAVOR) == OculusGoSecDxe || $(GO_BUILD_FLAVOR) == OculusGoDxeMem || $(GO_BUILD_FLAVOR) == OculusGoDxeGcd || $(GO_BUILD_FLAVOR) == OculusGoDxeTables || $(GO_BUILD_FLAVOR) == OculusGoDxeDebug || $(GO_BUILD_FLAVOR) == OculusGoDxeDispatch || $(GO_BUILD_FLAVOR) == OculusGoDxeGop || $(GO_BUILD_FLAVOR) == OculusGoDxeText || $(GO_BUILD_FLAVOR) == OculusGoDxeApp
0x00001000|0x0007F000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVCOMPACT

!if $(GO_BUILD_FLAVOR) == OculusGoDxeDebug || $(GO_BUILD_FLAVOR) == OculusGoDxeDispatch || $(GO_BUILD_FLAVOR) == OculusGoDxeGop || $(GO_BUILD_FLAVOR) == OculusGoDxeText || $(GO_BUILD_FLAVOR) == OculusGoDxeApp
0x00080000|0x00300000
DATA = { 0x47,0x4f,0x44,0x58,0x45,0x46,0x44,0x31 }
# Aligned EFI_SYSTEM_TABLE_POINTER page in the loaded image. Adjacent pages are guards.
0x00380000|0x00001000
DATA = { 0xff }
0x00381000|0x0003D000
DATA = { 0xff }
!else
0x00080000|0x0033E000
DATA = { 0x47,0x4f,0x44,0x58,0x45,0x46,0x44,0x31 }
!endif
0x003BE000|0x00042000
DATA = { 0x47,0x4f,0x53,0x54,0x41,0x43,0x4b,0x31 }
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsQueues || $(GO_BUILD_FLAVOR) == OculusGoUfsLkMap || $(GO_BUILD_FLAVOR) == OculusGoUfsData || $(GO_BUILD_FLAVOR) == OculusGoUfsGptModel || $(GO_BUILD_FLAVOR) == OculusGoUfsZero4k || $(GO_BUILD_FLAVOR) == OculusGoUfsBuf4k || $(GO_BUILD_FLAVOR) == OculusGoUfsBounce || $(GO_BUILD_FLAVOR) == OculusGoUfsNop11
0x00001000|0x003BD000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVCOMPACT
0x003BE000|0x00002000
DATA = { 0x47,0x4f,0x53,0x54,0x41,0x43,0x4b,0x31 }
# Private inspection window 0x80440000..0x80443fff. No allocations or stack here.
0x003C0000|0x00004000
DATA = { 0xff }
# Stack grows from 0x8047f000, upper guard occupies the final 4 KiB.
0x003C4000|0x0003C000
DATA = { 0xff }
!elseif $(GO_BUILD_FLAVOR) == OculusGoSecStack || $(GO_BUILD_FLAVOR) == OculusGoSecMmu || $(GO_BUILD_FLAVOR) == OculusGoUfsHandoff
0x00001000|0x003BD000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVCOMPACT

# One guard page, the 256 KiB stack, and one guard page, all inside the FD.
0x003BE000|0x00042000
DATA = { 0x47,0x4f,0x53,0x54,0x41,0x43,0x4b,0x31 }
!else
0x00001000|0x003FF000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVCOMPACT
!if $(GO_BUILD_FLAVOR) == OculusGo || $(GO_BUILD_FLAVOR) == OculusGoShellQemu
0x00400000|0x00fff000
DATA = { 0x47,0x4f,0x41,0x52,0x45,0x4e,0x41,0x31 }
0x013ff000|0x00001000
DATA = { 0x47,0x4f,0x41,0x52,0x45,0x4e,0x41,0x32 }
!endif
!endif

[FV.FVCOMPACT]
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
READ_STATUS        = TRUE
WRITE_STATUS       = TRUE
!if $(GO_BUILD_FLAVOR) == OculusGoSecDxe || $(GO_BUILD_FLAVOR) == OculusGoDxeMem || $(GO_BUILD_FLAVOR) == OculusGoDxeGcd || $(GO_BUILD_FLAVOR) == OculusGoDxeTables || $(GO_BUILD_FLAVOR) == OculusGoDxeDebug || $(GO_BUILD_FLAVOR) == OculusGoDxeDispatch || $(GO_BUILD_FLAVOR) == OculusGoDxeGop || $(GO_BUILD_FLAVOR) == OculusGoDxeText || $(GO_BUILD_FLAVOR) == OculusGoDxeApp
  INF OculusGoPkg/SecMmu/SecDxe.inf
  FILE FV_IMAGE = 795b7b9c-616a-4a56-a9fa-f9cfec95bd66 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVTRIALDXE
    }
  }

[FV.FVTRIALDXE]
BlockSize = 0x40
NumBlocks = 0
FvAlignment = 8
ERASE_POLARITY = 1
MEMORY_MAPPED = TRUE
READ_STATUS = TRUE
WRITE_STATUS = TRUE
  INF RuleOverride = ALIGNED_DXE MdeModulePkg/Core/Dxe/DxeMain.inf
!if $(GO_BUILD_FLAVOR) == OculusGoDxeDispatch || $(GO_BUILD_FLAVOR) == OculusGoDxeGop || $(GO_BUILD_FLAVOR) == OculusGoDxeText || $(GO_BUILD_FLAVOR) == OculusGoDxeApp
  INF MdeModulePkg/Universal/DevicePathDxe/DevicePathDxe.inf
!endif
!if $(GO_BUILD_FLAVOR) == OculusGoDxeText || $(GO_BUILD_FLAVOR) == OculusGoDxeApp
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopText.inf
!if $(GO_BUILD_FLAVOR) == OculusGoDxeApp
  INF OculusGoPkg/Applications/ConsoleProbe/ConsoleProbe.inf
!endif
!elseif $(GO_BUILD_FLAVOR) == OculusGoDxeGop
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopDisplay.inf
!endif
!elseif $(GO_BUILD_FLAVOR) == OculusGoSecMmu
  INF OculusGoPkg/SecMmu/SecMmu.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsQueues
  INF OculusGoPkg/SecMem/UfsQueues.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsLkMap
  INF OculusGoPkg/SecMem/UfsLkMap.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsGptModel
  INF OculusGoPkg/SecMem/UfsGptModel.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsZero4k
  INF OculusGoPkg/SecMem/UfsZero4k.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsBuf4k
  INF OculusGoPkg/SecMem/UfsBuf4k.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsBounce
  INF OculusGoPkg/SecMem/UfsBounce.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsData
  INF OculusGoPkg/SecMem/UfsData.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsNop11
  INF OculusGoPkg/SecMem/UfsNop11.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoUfsHandoff
  INF OculusGoPkg/SecMem/UfsHandoff.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoSecStack
  INF OculusGoPkg/SecMem/SecStack.inf
!elseif $(GO_BUILD_FLAVOR) == OculusGoSecMem
  INF OculusGoPkg/SecMem/SecMem.inf
!else
  INF OculusGoPkg/PrePi/PrePi.inf
  FILE FV_IMAGE = 795b7b9c-616a-4a56-a9fa-f9cfec95bd66 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

[FV.FVMAIN]
BlockSize          = 0x40
NumBlocks          = 0
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
READ_STATUS        = TRUE
WRITE_STATUS       = TRUE

APRIORI DXE {
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF OculusGoPkg/Drivers/TrustMeBroDxe/TrustMeBroDxe.inf
!if $(GO_BUILD_FLAVOR) == OculusGoGopModel
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopDxe.inf
!endif
}
!if $(GO_BUILD_FLAVOR) == OculusGo || $(GO_BUILD_FLAVOR) == OculusGoShellQemu
  INF MdeModulePkg/Universal/DevicePathDxe/DevicePathDxe.inf
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopText.inf
  INF MdeModulePkg/Universal/HiiDatabaseDxe/HiiDatabaseDxe.inf
  INF MdeModulePkg/Universal/Disk/UnicodeCollation/EnglishDxe/EnglishDxe.inf
  INF MdeModulePkg/Universal/Variable/RuntimeDxe/VariableRuntimeDxe.inf
  INF MdeModulePkg/Universal/CapsuleRuntimeDxe/CapsuleRuntimeDxe.inf
  INF MdeModulePkg/Universal/WatchdogTimerDxe/WatchdogTimer.inf
  INF EmbeddedPkg/RealTimeClockRuntimeDxe/RealTimeClockRuntimeDxe.inf
  INF MdeModulePkg/Universal/Console/ConSplitterDxe/ConSplitterDxe.inf
  INF OculusGoPkg/Drivers/GoBdsDxe/GoBdsDxe.inf
  INF ShellPkg/Application/Shell/Shell.inf
!endif
  INF MdeModulePkg/Core/Dxe/DxeMain.inf
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF OculusGoPkg/Drivers/TrustMeBroDxe/TrustMeBroDxe.inf
!if $(GO_BUILD_FLAVOR) == OculusGoGopModel
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopDxe.inf
!endif
  INF ArmPkg/Drivers/ArmGic/ArmGicDxe.inf
  INF ArmPkg/Drivers/CpuDxe/CpuDxe.inf
  INF ArmPkg/Drivers/TimerDxe/TimerDxe.inf
  INF EmbeddedPkg/MetronomeDxe/MetronomeDxe.inf
  INF EmbeddedPkg/EmbeddedMonotonicCounter/EmbeddedMonotonicCounter.inf
  INF MdeModulePkg/Core/RuntimeDxe/RuntimeDxe.inf
  INF MdeModulePkg/Universal/ResetSystemRuntimeDxe/ResetSystemRuntimeDxe.inf
  INF MdeModulePkg/Universal/SecurityStubDxe/SecurityStubDxe.inf
!endif

!include ArmVirtPkg/ArmVirtRules.fdf.inc

# SEC parses PE32+ while stage-1 is off. Require natural 64-bit alignment.
[Rule.Common.DXE_CORE.ALIGNED_DXE]
  FILE DXE_CORE = $(NAMED_GUID) {
    PE32 PE32 Align = 8 $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI STRING="$(MODULE_NAME)" Optional
  }
