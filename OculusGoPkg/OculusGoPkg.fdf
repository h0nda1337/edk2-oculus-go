## SPDX-License-Identifier: BSD-2-Clause-Patent
# Integrated ARM64 ABI header, followed by an EDK2 firmware volume.
# Header fields: official Go kernel Documentation/arm64/booting.txt.
# FV reset-vector generation: upstream EDK2 GenFv and ArmVirtQemuKernel.fdf.
[FD.OCULUS_GO_DIRECT]
BaseAddress   = 0x80080000|gArmTokenSpaceGuid.PcdFdBaseAddress
Size          = 0x00400000|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1
BlockSize     = 0x1000
NumBlocks     = 0x400

0x00000000|0x00001000
DATA = {
  0x00,0x04,0x00,0x14, 0x1f,0x20,0x03,0xd5, # b +0x1000; nop
  0x00,0x00,0x08,0x00,0x00,0x00,0x00,0x00, # text_offset 0x80000
  0x00,0x00,0x40,0x00,0x00,0x00,0x00,0x00, # image_size 4 MiB
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00, # flags
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x41,0x52,0x4d,0x64, 0x00,0x00,0x00,0x00
}

0x00001000|0x003FF000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVCOMPACT

[FV.FVCOMPACT]
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
READ_STATUS        = TRUE
WRITE_STATUS       = TRUE
  INF OculusGoPkg/PrePi/PrePi.inf
  FILE FV_IMAGE = 795b7b9c-616a-4a56-a9fa-f9cfec95bd66 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

[FV.FVMAIN]
BlockSize          = 0x40
NumBlocks          = 0
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
READ_STATUS        = TRUE
WRITE_STATUS       = TRUE

APRIORI DXE {
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF OculusGoPkg/Drivers/TrustMeBroDxe/TrustMeBroDxe.inf
!if $(GO_BUILD_FLAVOR) == OculusGoGopModel
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopDxe.inf
!endif
}
  INF MdeModulePkg/Core/Dxe/DxeMain.inf
  INF MdeModulePkg/Universal/PCD/Dxe/Pcd.inf
  INF OculusGoPkg/Drivers/TrustMeBroDxe/TrustMeBroDxe.inf
!if $(GO_BUILD_FLAVOR) == OculusGoGopModel
  INF OculusGoPkg/Drivers/InheritedGopDxe/InheritedGopDxe.inf
!endif
  INF ArmPkg/Drivers/ArmGic/ArmGicDxe.inf
  INF ArmPkg/Drivers/CpuDxe/CpuDxe.inf
  INF ArmPkg/Drivers/TimerDxe/TimerDxe.inf
  INF EmbeddedPkg/MetronomeDxe/MetronomeDxe.inf
  INF EmbeddedPkg/EmbeddedMonotonicCounter/EmbeddedMonotonicCounter.inf
  INF MdeModulePkg/Core/RuntimeDxe/RuntimeDxe.inf
  INF MdeModulePkg/Universal/ResetSystemRuntimeDxe/ResetSystemRuntimeDxe.inf
  INF MdeModulePkg/Universal/SecurityStubDxe/SecurityStubDxe.inf

!include ArmVirtPkg/ArmVirtRules.fdf.inc
