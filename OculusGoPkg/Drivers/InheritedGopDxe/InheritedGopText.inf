[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = InheritedGopDxe
  FILE_GUID      = 8cd15dc8-f091-4917-b779-342c1e0aa2de
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = InheritedGopDxeEntry
[BuildOptions]
  GCC:*_*_AARCH64_CC_FLAGS = -DOCULUS_GO_GOP_DEVICE_PATH=1 -DOCULUS_GO_TEXT=1
[Sources]
  InheritedGopDxe.c
  TextConsole.c
[Packages]
  MdePkg/MdePkg.dec
  OculusGoPkg/OculusGoPkg.dec
[LibraryClasses]
  BaseMemoryLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiDevicePathUtilitiesProtocolGuid
  gEfiSimpleTextOutProtocolGuid
[Depex]
  gEfiDevicePathUtilitiesProtocolGuid
