[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = OculusGoUfsGptModel
  FILE_GUID      = 67abacac-0b70-444a-85da-cbf0aa919692
  MODULE_TYPE    = SEC
  VERSION_STRING = 1.0

[Sources.AARCH64]
  UfsEntry.S | GCC
  UfsHandoff.c
  UfsQueues.c
  UfsLkMap.c
  UfsData.c
  UfsHeaderBuffer.c
  UfsGptModel.c
  UfsNop11.c
  UfsNop11Ring.S | GCC
  Fdt.c

[LibraryClasses]
  BaseLib

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  OculusGoPkg/OculusGoPkg.dec

[BuildOptions]
  GCC:*_*_AARCH64_CC_FLAGS = -DGO_UFS_QUEUES -DGO_UFS_LK_MAP -DGO_UFS_DATA -DGO_UFS_HEADER_BUFFER -DGO_UFS_GPT_MODEL
