[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = OculusGoUfsData
  FILE_GUID      = 28b403d4-daca-48ec-a821-683f1404c003
  MODULE_TYPE    = SEC
  VERSION_STRING = 1.0

[Sources.AARCH64]
  UfsEntry.S | GCC
  UfsHandoff.c
  UfsQueues.c
  UfsLkMap.c
  UfsData.c
  UfsNop11.c
  UfsNop11Ring.S | GCC
  Fdt.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  OculusGoPkg/OculusGoPkg.dec

[BuildOptions]
  GCC:*_*_AARCH64_CC_FLAGS = -DGO_UFS_QUEUES -DGO_UFS_LK_MAP -DGO_UFS_DATA
